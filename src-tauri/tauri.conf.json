{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ifuyo-tide",
  "version": "0.1.0",
  "identifier": "com.ifuyo.tide",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tide",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self' http://127.0.0.1:* http://localhost:*; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tide"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "Tide Torrent File",
        "description": "BitTorrent metadata file \u2014 open with Tide",
        "role": "Editor"
      }
    ]
  }
}
